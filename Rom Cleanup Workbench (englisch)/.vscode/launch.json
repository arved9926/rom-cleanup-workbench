{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rom Cleanup Workbench (englisch): report only",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/duplicate_finder.py",
      "args": ["${input:directory}", "--report-only"],
      "console": "integratedTerminal"
    },
    {
      "name": "Rom Cleanup Workbench (englisch): analysis window",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/duplicate_finder.py",
      "args": ["${input:directory}"],
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "directory",
      "type": "promptString",
      "description": "Directory to check"
    }
  ]
}
